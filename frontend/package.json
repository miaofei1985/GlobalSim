{
  "name": "globalsim-frontend",
  "version": "1.0.0",
  "description": "GlobalSim 寰宇模拟盘前端应用 - 3D地球交互交易平台",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "format": "prettier --write src/",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "vue": "^3.4.3",
    "vue-router": "^4.2.5",
    "pinia": "^2.1.7",
    "axios": "^1.6.2",
    "three": "^0.160.0",
    "@types/three": "^0.160.0",
    "gsap": "^3.12.4",
    "lightweight-charts": "^4.1.1",
    "vue-i18n": "^9.8.0",
    "socket.io-client": "^4.7.2",
    "dayjs": "^1.11.10",
    "uuid": "^9.0.1",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.5.2",
    "vite": "^5.0.8",
    "vue-tsc": "^1.8.25",
    "typescript": "^5.3.3",
    "@vue/tsconfig": "^0.5.1",
    "@types/node": "^20.10.5",
    "eslint": "^8.55.0",
    "eslint-plugin-vue": "^9.19.2",
    "prettier": "^3.1.1",
    "vitest": "^1.0.4",
    "@vitest/coverage-v8": "^1.0.4",
    "sass": "^1.69.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
